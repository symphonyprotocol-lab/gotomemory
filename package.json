{
  "name": "gotomemory",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform Memory Control Plane monorepo. See specs/.",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!@gotomemory/sync --filter=!@gotomemory/sdk --filter=!@gotomemory/cli --filter=!@gotomemory/mcp-server",
    "lint": "turbo run lint --filter=!@gotomemory/sync --filter=!@gotomemory/sdk --filter=!@gotomemory/cli --filter=!@gotomemory/mcp-server",
    "typecheck": "turbo run typecheck --filter=!@gotomemory/sync --filter=!@gotomemory/sdk --filter=!@gotomemory/cli --filter=!@gotomemory/mcp-server",
    "test": "turbo run test --filter=!@gotomemory/sync --filter=!@gotomemory/sdk --filter=!@gotomemory/cli --filter=!@gotomemory/mcp-server",
    "build:frozen": "turbo run build --filter=@gotomemory/sync --filter=@gotomemory/sdk --filter=@gotomemory/cli --filter=@gotomemory/mcp-server",
    "lint:frozen": "turbo run lint --filter=@gotomemory/sync --filter=@gotomemory/sdk --filter=@gotomemory/cli --filter=@gotomemory/mcp-server",
    "typecheck:frozen": "turbo run typecheck --filter=@gotomemory/sync --filter=@gotomemory/sdk --filter=@gotomemory/cli --filter=@gotomemory/mcp-server",
    "test:frozen": "turbo run test --filter=@gotomemory/sync --filter=@gotomemory/sdk --filter=@gotomemory/cli --filter=@gotomemory/mcp-server",
    "dev": "turbo run dev",
    "codegen": "turbo run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages tooling --config tooling/dependency-cruiser.cjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run boundaries",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "py:install": "cd py && uv sync",
    "py:test": "cd py && uv run pytest -q",
    "py:lint": "cd py && uv run ruff check . && uv run mypy sdk/src"
  },
  "prettier": "@gotomemory/config-ts/prettier",
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@gotomemory/config-ts": "workspace:*",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
